# BabyyGurll Crochet Environment Configuration
PORT=5000
NODE_ENV=development

# Optional: MongoDB Connection String (Atlas or Local)
# If left empty, the server automatically boots an embedded zero-config MongoDB in-memory store!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/babyygurll?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/babyygurll

# Shiprocket API Configuration
SHIPROCKET_EMAIL=your_shiprocket_api_user@example.com
SHIPROCKET_PASSWORD=your_shiprocket_api_password

# Razorpay Standard Checkout Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id